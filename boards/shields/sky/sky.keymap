#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define MAC_OS 1
#define GAMING 2
#define FN 3

#define MOUSE 4
#define SCROLL 5

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp PSCRN               &kp BSLH    &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp DEL
                &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &kp LBKT                &kp RBKT    &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
                &kp CAPS    &kp A       &kp S       &kp D       &kp F       &kp G       &kp GRAVE               &kp APOS    &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp ENTER
                &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B                               &none       &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH   &kp RSHIFT
                &kp LCTRL   &kp LGUI    &kp LEFT    &kp RIGHT   &kp SPACE   &mo 3       &mo 4                   &mo 3       &tog 4      &mkp LCLK   &kp DOWN    &kp UP      &kp MINUS   &kp EQUAL
                                                                &kp LCTRL   &kp LALT    &none
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        mac_os {
            bindings = <
                &trans      &trans      &trans      &trans      &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans      &trans      &trans
                                                                &kp LGUI    &trans      &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        gaming {
            bindings = <
                &none       &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                  &kp BSLH    &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp DEL
                &none       &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T                   &kp RBKT    &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
                &none       &kp CAPS    &kp A       &kp S       &kp D       &kp F       &kp G                   &kp APOS    &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp ENTER
                &none       &kp LSHFT   &kp Z       &kp X       &kp C       &kp V                               &none       &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH   &kp RSHIFT
                &none       &kp LCTRL   &kp LEFT    &kp RIGHT   &trans      &mo 6       &kp B                   &mo 3       &tog 4      &mkp LCLK   &kp DOWN    &kp UP      &kp MINUS   &kp EQUAL
                                                                &trans      &trans      &kp M
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        fn {
            bindings = <
                &kp F1      &kp F2       &kp F3       &kp F4       &kp F5       &kp F6  &sys_reset              &sys_reset  &kp F7      &kp F8      &kp F9       &kp F10      &kp F11      &kp F12
                &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans  &trans                  &trans      &trans      &trans      &trans       &trans       &trans       &trans
                &none       &trans       &trans       &trans       &trans       &trans  &tog 2                  &tog 1      &trans      &trans      &trans       &trans       &trans       &trans
                &none       &trans       &trans       &trans       &trans       &trans                          &trans      &trans      &trans      &trans       &trans       &trans       &trans
                &sys_reset  &trans       &trans       &trans       &trans       &trans  &trans                  &trans      &trans      &trans      &trans       &trans       &trans       &trans
                                                                   &trans       &trans  &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        mouse {
            bindings = <
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &mkp LCLK   &mkp MCLK   &mkp RCLK    &mo 5        &trans
                &trans      &trans       &trans       &trans       &trans       &trans                          &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                                                                   &trans       &trans       &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        scroll {
            bindings = <
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans                          &trans      &trans       &trans      &trans      &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans             &trans      &trans       &trans      &trans      &trans       &trans       &trans
                                                                   &trans       &trans       &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        gaming_fn {
            bindings = <
                &trans      &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                  &kp F6      &kp F7      &kp F8      &kp F9       &kp F10      &kp F11      &kp F12
                &trans      &trans       &trans       &trans       &trans       &trans       &trans                  &trans      &trans      &trans      &trans       &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &tog 2                  &trans      &trans      &trans      &trans       &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans                               &trans      &trans      &trans      &trans       &trans       &trans       &trans
                &trans      &trans       &trans       &trans       &trans       &trans       &trans                  &trans      &trans      &trans      &trans       &trans       &trans       &trans
                                                                   &trans       &trans       &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };
    };
 };
